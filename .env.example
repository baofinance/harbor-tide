# RPC endpoints
MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
ARBITRUM_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY"
BASE_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_KEY"
MEGAETH_RPC_URL="https://YOUR_MEGAETH_RPC"
ROBINHOOD_RPC_URL="https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY"
LOCAL_URL="http://127.0.0.1:8545"

# Deployer: this repo uses Foundry keystore accounts (cast wallet), not raw private keys.
# Import once:   cast wallet import deployer --interactive
# Then deploy:   forge script ... --account deployer --sender <deployer-address>
# (No PRIVATE_KEY in .env.)

# Verification: Etherscan API V2 uses ONE key for all chains (incl. MegaETH, Robinhood via ?chainid=).
ETHERSCAN_API_KEY=""
